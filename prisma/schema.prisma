generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Albergue {
  id                  String          @id @default(cuid())
  nombre              String
  direccion           String
  capacidad           Int
  ocupadas            Int             @default(0)
  ultimaActualizacion DateTime        @default(now())
  aprobado            Boolean         @default(false)
  usuarios            Usuario[]
  reportes            ReporteDiario[]
}

model Usuario {
  id             String       @id @default(cuid())
  correo         String       @unique
  contrasenaHash String
  rol            String
  albergueId     String?
  albergue       Albergue?    @relation(fields: [albergueId], references: [id])
  afectaciones   Afectacion[]
}

model ReporteDiario {
  id         String   @id @default(cuid())
  albergueId String
  personas   Int
  fecha      DateTime @default(now())
  albergue   Albergue @relation(fields: [albergueId], references: [id])
}

model Afectacion {
  id              String   @id @default(cuid())
  usuarioId       String
  tipo            String
  descripcion     String
  grupo           String
  perdidaEstimada Int
  estado          String   @default("pendiente")
  estrategia      String?
  apoyoAsignado   Int?
  fecha           DateTime @default(now())
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
}
model OfertaEmpleo {
  id               String   @id @default(cuid())
  titulo           String
  empresa          String
  descripcion      String
  cupos            Int
  grupoPrioritario String
  activa           Boolean  @default(true)
  fecha            DateTime @default(now())
}